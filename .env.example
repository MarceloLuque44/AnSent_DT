# Servidor
PORT=3000
NODE_ENV=development

# Postgres / Supabase
# Usar el connection string del pooler de Supabase (puerto 6543) si está disponible.
DATABASE_URL=postgresql://usuario:password@host:6543/postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=3

# Clave que usa R en el header x-api-key para POST /api/cambios
R_API_KEY=cambia-esta-clave-por-una-larga

# Orígenes permitidos por CORS. En producción incluir la URL de Render.
CORS_ORIGINS=http://localhost:5173
